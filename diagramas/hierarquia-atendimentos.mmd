classDiagram
    direction TB

    class Atendimento {
        <<abstract>>
        #data: Date
        #observacoes: String
        +calcularValor() double*
        +getData() Date
    }

    class Consulta {
        -valorConsulta: double
        -retorno: boolean
        +calcularValor() double
    }

    class Procedimento {
        <<abstract>>
        #valorBase: double
        #valorMaterial: double
    }

    class Vacina {
        -nomeVacina: String
        -reforco: boolean
        +calcularValor() double
    }

    class Exame {
        -tipoExame: String
        -urgente: boolean
        +calcularValor() double
    }

    class Cirurgia {
        -valorAnestesia: double
        -diasInternacao: int
        -valorDiaria: double
        +calcularValor() double
    }

    Atendimento <|-- Consulta
    Atendimento <|-- Procedimento
    Procedimento <|-- Vacina
    Procedimento <|-- Exame
    Procedimento <|-- Cirurgia
